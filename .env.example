# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (Gemini, https://aistudio.google.com/apikey) ---
# GEMINI_API_KEY и GEMINI_API_KEY2 — бесплатные, пробуются первыми по порядку;
# GEMINI_API_KEY3 (платный) — фолбэк, включается только когда первые два не сработали
# (квота исчерпана, ключ невалиден). Можно оставить только GEMINI_API_KEY.
GEMINI_API_KEY=
GEMINI_API_KEY2=
GEMINI_API_KEY3=

# --- Telegram (@BotFather) ---
TELEGRAM_BOT_TOKEN=
# любой случайный секрет, тот же передаётся в setWebhook
TELEGRAM_WEBHOOK_SECRET=
# chat_id владельца (можно узнать у @userinfobot); дублирует config/settings.json
TELEGRAM_CHAT_ID=

# --- hh.ru OAuth-приложение (https://dev.hh.ru) ---
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=
# обязательный заголовок для api.hh.ru
HH_USER_AGENT=JobAgent/1.0 (you@example.com)

# --- Шифрование hh-токенов в БД (любая длинная случайная строка) ---
TOKEN_ENCRYPTION_KEY=

# --- Basic auth для веб-дашборда (пусто = дашборд открыт) ---
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# --- id владельца в таблице users (сидится схемой, менять не нужно) ---
OWNER_USER_ID=00000000-0000-0000-0000-000000000001
